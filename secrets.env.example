# Copy to secrets.env (mode 600) and fill from the Passwords app entry "restic <host>".
# Never commit secrets.env. Keep the single quotes around values.
BACKUP_HOST='REPLACE_ME'            # m4-air or m2-air (must match a file in hosts/)
RESTIC_PASSWORD='REPLACE_ME'        # restic repository password
AWS_ACCESS_KEY_ID='REPLACE_ME'      # B2 keyID (used through B2's S3-compatible API)
AWS_SECRET_ACCESS_KEY='REPLACE_ME'  # B2 applicationKey
HC_BACKUP_URL='REPLACE_ME'          # https://hc-ping.com/<uuid> of check backup-<host>
HC_CHECK_URL='REPLACE_ME'           # https://hc-ping.com/<uuid> of check check-<host>
